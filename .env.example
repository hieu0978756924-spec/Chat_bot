# ==============================================================================
# CẤU HÌNH TRỢ LÝ ĐẶT BÀN NHÀ HÀNG (LOCAL LLM)
# ==============================================================================

# Local LLM qua Ollama. LLM_PROVIDER=none -> chỉ dùng NLU dự phòng (embedding).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Máy 8GB RAM / chỉ CPU: qwen2.5:3b. Máy >=16GB RAM hoặc có GPU: qwen2.5:7b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096

# Cơ sở dữ liệu SQLite
SQLITE_DB_PATH=./data_store/app.db

# RAG chính sách (FAISS + Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=./data_store/faiss_policy.index
RAG_THRESHOLD=0.40
RAG_TOP_K=3

# Nghiệp vụ
CHEAP_BUDGET_VND=150000
DEMO_DAYS=14
